# BHIMS environment configuration (template).
# Copy to `.env` (already git-ignored) and fill in per environment.

# --- Core security -----------------------------------------------------------
# Generated automatically on first run if missing. Regenerating invalidates
# all sessions and password-reset tokens.
# DJANGO_SECRET_KEY=

# 1 = verbose debug mode (development only, NEVER in production)
# 0 = hardened production mode (default)
# DJANGO_DEBUG=0

# Comma-separated hostnames the site may be served under.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Extra origins (with scheme) allowed to POST cross-origin, e.g. when the site
# is reachable under multiple subdomains.
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Admin hardening ---------------------------------------------------------
# IP allowlist for the Django admin + BHIMS admin pages (empty = allow all).
# DJANGO_ADMIN_IPS=127.0.0.1

# Path segment for Django's superuser admin (default: django-admin).
# DJANGO_ADMIN_URL=django-admin

# TOTP secret for admin sign-in 2FA — generate with:
#   python manage.py generate_totp_secret
# DJANGO_ADMIN_TOTP_SECRET=

# --- Database (XAMPP MariaDB) -----------------------------------------------
# Set a root password in phpMyAdmin (User accounts -> root -> change password),
# then fill these in. Create a dedicated user for the app in real deployments.
# DJANGO_DB_NAME=boarding_house_system
# DJANGO_DB_USER=root
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=3306

# --- Email (password reset delivery) ----------------------------------------
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=noreply@boardinghouse.local
# DJANGO_EMAIL_HOST=
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=1

# --- Ops ---------------------------------------------------------------------
# Error-notification recipients: "Name a@x.com, Name2 b@x.com"
# DJANGO_ADMINS=
