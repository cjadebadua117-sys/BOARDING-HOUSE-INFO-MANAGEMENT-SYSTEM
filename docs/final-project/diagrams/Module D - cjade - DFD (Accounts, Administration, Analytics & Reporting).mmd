    D2 -- "listing counts" --> P8
    D5 -- "booking &amp; occupancy stats" --> P8
    D6 -- "rating stats" --> P8
    D7 -- "report stats" --> P8
    ADM -- "manage barangays &amp; settings" --> P8
    P8 -- "barangay records" --> D3
    P8 -- "admin action record" --> D8
    D8 -- "site settings" --> P8
    P8 -- "dashboard, analytics, audit trail" --> ADM
    P8 -- "account updates" --> D1

