%% Module C - ERD extract: Rating & User Reporting (owner: Jerome)
%% The eligibility rule is visible in the schema: LANDLORD_RATING is one-to-one
%% with BOOKING, so a rating cannot exist without a confirmed booking, and the
%% unique constraint stops a second rating for the same landlord.
%% Render: venv\Scripts\python.exe tools\render_diagrams.py docs\final-project\diagrams
erDiagram
    USER ||--o{ BOOKING : "requests"
    BOOKING ||--|| LANDLORD_RATING : "unlocks one"
    USER ||--o{ LANDLORD_RATING : "gives"
    USER ||--o{ LANDLORD_RATING : "receives"
    USER ||--o{ USER_REPORT : "files"
    USER ||--o{ USER_REPORT : "is reported in"

    USER {
        int id PK
        string role "student or landlord"
        string full_name
    }
    BOOKING {
        int id PK
        int student_id FK
        int room_id FK
        string status "confirmed only - the rating key"
        datetime confirmed_at
    }
    LANDLORD_RATING {
        int id PK
        int student_id FK
        int landlord_id FK
        int booking_id FK "unique - one rating per booking"
        int rating "1 to 5"
        text comment
        datetime created_at
    }
    USER_REPORT {
        int id PK
        int reporter_id FK
        int reported_user_id FK
        string reason "harassment / scam / fake_listing / inappropriate / other"
        text details
        string status "pending / resolved / dismissed"
        datetime created_at
        datetime resolved_at
    }
